{
  "name": "@zynth/splash-screen",
  "version": "0.0.1",
  "description": "Native splash screen management for Zynth framework",
  "type": "module",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "ios",
    "android",
    "ZynthSplashScreen.podspec"
  ],
  "scripts": {
    "build": "yarn build:js && yarn build:types",
    "build:js": "rm -rf dist/esm && tsc --project tsconfig.esm.json",
    "build:types": "tsc --project tsconfig.types.json",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "zynth",
    "splash-screen",
    "launch-screen",
    "ios",
    "android"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@zynth/core": ">=0.0.1",
    "solid-js": ">=1.8.0"
  },
  "devDependencies": {
    "@rsbuild/core": "^1.5.0",
    "@zynth/rsbuild-plugin": "*",
    "typescript": "^5.6.3"
  },
  "zynthNative": {
    "ios": {
      "pods": [
        {
          "name": "ZynthSplashScreen",
          "podspec": "./ZynthSplashScreen.podspec"
        }
      ]
    },
    "android": {
      "modules": [
        {
          "name": "ZynthSplashScreen",
          "path": "./android/ZynthSplashScreen"
        }
      ],
      "initializer": {
        "className": "ZynthSplashScreen",
        "method": "initialize",
        "package": "dev.zynth.splashscreen",
        "args": ["activity", "runtime"]
      },
      "activityHooks": {
        "onCreate": ["ZynthSplashScreen.attach(splashScreen)"],
        "onFirstFrame": ["ZynthSplashScreen.markContentReady()"]
      }
    }
  }
}
