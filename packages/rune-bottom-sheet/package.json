{
  "name": "@rune/bottom-sheet",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist",
    "android",
    "ios",
    "src",
    "package.json",
    "README.md",
    "RuneBottomSheet.podspec",
    "rsbuild.config.ts"
  ],
  "peerDependencies": {
    "solid-js": ">=1.8.0",
    "@rune/core": "0.0.1",
    "@rune/apis": "0.0.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.24.7",
    "@babel/preset-typescript": "^7.24.7",
    "@rsbuild/core": "^1.0.1",
    "@rsbuild/plugin-babel": "^1.0.1",
    "@rune/apis": "0.0.1",
    "babel-preset-solid": "^1.8.0",
    "solid-js": "^1.8.0",
    "typescript": "^5.6.2"
  },
  "scripts": {
    "build": "yarn build:js && yarn build:types",
    "build:js": "rm -rf dist/esm && tsc --project tsconfig.esm.json",
    "build:types": "tsc --project tsconfig.types.json"
  },
  "runeNative": {
    "ios": {
      "pods": [
        {
          "name": "RuneBottomSheet",
          "podspec": "./RuneBottomSheet.podspec"
        }
      ]
    },
    "android": {
      "modules": [
        {
          "name": "RuneBottomSheet",
          "path": "./android/RuneBottomSheet"
        }
      ]
    }
  }
}
