{
  "name": "@rune/ui",
  "version": "0.0.1",
  "description": "Theme system and UI primitives for Rune",
  "type": "module",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "ios",
    "android",
    "RuneUI.podspec"
  ],
  "scripts": {
    "build": "yarn build:js && yarn build:types",
    "build:js": "rm -rf dist/esm && tsc --project tsconfig.json && cp -R src/themes dist/esm/themes",
    "build:types": "tsc --project tsconfig.types.json",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "rune",
    "ui",
    "theme",
    "native-module"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@rune/core": ">=0.0.1",
    "@rune/components": ">=0.0.1",
    "solid-js": ">=1.8.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "runeNative": {
    "ios": {
      "pods": [
        {
          "name": "RuneUI",
          "podspec": "./RuneUI.podspec"
        }
      ],
      "initializer": {
        "className": "RuneAppearanceModule",
        "method": "initializeWith:"
      }
    },
    "android": {
      "modules": [
        {
          "name": "RuneUI",
          "path": "./android/RuneUI"
        }
      ],
      "initializer": {
        "className": "RuneAppearance",
        "method": "initialize",
        "package": "dev.rune.ui"
      }
    }
  }
}
