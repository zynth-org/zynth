{
  "name": "@zynth/keyboard",
  "version": "0.0.1",
  "description": "Keyboard management utilities for Zynth framework",
  "type": "module",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "ios",
    "android",
    "ZynthKeyboard.podspec"
  ],
  "scripts": {
    "build": "yarn build:js && yarn build:types",
    "build:js": "rm -rf dist/esm && tsc --project tsconfig.esm.json",
    "build:types": "tsc --project tsconfig.types.json",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "zynth",
    "keyboard",
    "keyboard-controller",
    "keyboard-avoiding",
    "ios",
    "android"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@zynth/core": ">=0.0.1",
    "@zynth/components": ">=0.0.1",
    "solid-js": ">=1.8.0"
  },
  "devDependencies": {
    "@rsbuild/core": "^1.5.0",
    "@zynth/rsbuild-plugin": "*",
    "typescript": "^5.6.3"
  },
  "zynthNative": {
    "ios": {
      "pods": [
        {
          "name": "ZynthKeyboard",
          "podspec": "./ZynthKeyboard.podspec"
        }
      ],
      "initializer": {
        "className": "ZynthKeyboard",
        "method": "initializeWith:"
      }
    },
    "android": {
      "modules": [
        {
          "name": "ZynthKeyboard",
          "path": "./android/ZynthKeyboard"
        }
      ],
      "initializer": {
        "className": "ZynthKeyboard",
        "method": "initialize",
        "package": "dev.zynth.keyboard"
      }
    }
  }
}
