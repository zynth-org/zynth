{
  "name": "@zynth/router",
  "version": "0.0.1-alpha.0",
  "type": "module",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./rsbuild": {
      "import": "./rsbuild.js",
      "types": "./rsbuild.d.ts"
    },
    "./*": "./*",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "filesystem-router.js",
    "filesystem-router.d.ts",
    "rsbuild.js",
    "rsbuild.d.ts",
    "package.json",
    "README.md"
  ],
  "peerDependencies": {
    "@zynth/core": ">=0.0.1-alpha.0",
    "@zynth/screens": ">=0.0.1-alpha.0",
    "@zynth/components": ">=0.0.1-alpha.0",
    "@zynth/apis": ">=0.0.1-alpha.0",
    "solid-js": ">=1.8.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.24.7",
    "@babel/preset-typescript": "^7.24.7",
    "@rsbuild/core": "^1.0.1",
    "@rsbuild/plugin-babel": "^1.0.1",
    "@zynth/apis": "0.0.1-alpha.0",
    "@zynth/components": "0.0.1-alpha.0",
    "@zynth/core": "0.0.1-alpha.0",
    "@zynth/screens": "0.0.1-alpha.0",
    "babel-preset-solid": "^1.8.0",
    "solid-js": "^1.8.0",
    "typescript": "^5.6.2"
  },
  "scripts": {
    "build": "yarn build:js && yarn build:types",
    "build:js": "rm -rf dist/esm && esbuild src/*.ts src/*.tsx src/**/*.ts src/**/*.tsx --outdir=dist/esm --format=esm --jsx=automatic --jsx-import-source=solid-js --loader:.ts=ts --loader:.tsx=tsx",
    "build:types": "tsc --project tsconfig.types.json && mv dist/types/packages/zynth-router/src/* dist/types/ && rm -rf dist/types/packages"
  }
}
