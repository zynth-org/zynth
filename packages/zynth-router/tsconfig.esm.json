{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@zynth/bottom-sheet": ["../zynth-bottom-sheet/dist/types/index.d.ts"],
      "@zynth/bottom-sheet/*": ["../zynth-bottom-sheet/dist/types/*"]
    },
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "rootDir": "src",
    "outDir": "dist/esm",
    "declaration": false,
    "emitDeclarationOnly": false,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "solid-js"
  },
  "include": [
    "src"
  ]
}
