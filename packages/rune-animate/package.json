{
  "name": "@rune/animate",
  "version": "0.0.1",
  "description": "Animation primitives for Rune",
  "type": "module",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "ios",
    "android",
    "RuneAnimate.podspec"
  ],
  "scripts": {
    "build": "yarn build:js && yarn build:types",
    "build:js": "rm -rf dist/esm && tsc --project tsconfig.esm.json",
    "build:types": "tsc --project tsconfig.types.json",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "rune",
    "animate",
    "animation",
    "shared-value",
    "solid-js"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@rune/core": ">=0.0.1",
    "@rune/components": ">=0.0.1",
    "solid-js": ">=1.8.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "runeNative": {
    "ios": {
      "pods": [
        {
          "name": "RuneAnimate",
          "podspec": "./RuneAnimate.podspec"
        }
      ],
      "initializer": {
        "className": "RuneAnimate",
        "method": "initializeWith:"
      }
    },
    "android": {
      "modules": [
        {
          "name": "RuneAnimate",
          "path": "./android/RuneAnimate"
        }
      ],
      "initializer": {
        "className": "RuneAnimate",
        "method": "initialize",
        "package": "dev.rune.animate",
        "args": ["runtime"]
      }
    }
  }
}
