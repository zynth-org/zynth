{
  "name": "@zynthjs/webview",
  "version": "0.0.1-alpha.0",
  "description": "Native WebView component for Zynth",
  "type": "module",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist",
    "android",
    "ios",
    "src",
    "package.json",
    "README.md",
    "ZynthWebView.podspec"
  ],
  "peerDependencies": {
    "solid-js": ">=1.8.0",
    "@zynthjs/core": "0.0.1-alpha.0"
  },
  "devDependencies": {
    "typescript": "^5.6.2"
  },
  "scripts": {
    "build": "yarn build:js && yarn build:types",
    "build:js": "rm -rf dist/esm && tsc --project tsconfig.esm.json",
    "build:types": "tsc --project tsconfig.types.json"
  },
  "zynthNative": {
    "ios": {
      "pods": [
        {
          "name": "ZynthWebView",
          "podspec": "./ZynthWebView.podspec"
        }
      ]
    },
    "android": {
      "modules": [
        {
          "name": "ZynthWebView",
          "path": "./android/ZynthWebView"
        }
      ]
    }
  }
}
