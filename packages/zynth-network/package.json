{
  "name": "@zynth/network",
  "version": "0.0.1",
  "description": "Network state and local peer discovery for Zynth",
  "type": "module",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "ios",
    "android",
    "ZynthNetwork.podspec",
    "src"
  ],
  "scripts": {
    "build": "yarn build:js && yarn build:types",
    "build:js": "rm -rf dist/esm && tsc --project tsconfig.esm.json",
    "build:types": "tsc --project tsconfig.types.json",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "zynth",
    "network",
    "bonjour",
    "mdns",
    "android",
    "ios"
  ],
  "license": "MIT",
  "peerDependencies": {
    "solid-js": ">=1.8.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "zynthNative": {
    "ios": {
      "pods": [
        {
          "name": "ZynthNetwork",
          "podspec": "./ZynthNetwork.podspec"
        }
      ],
      "initializer": {
        "className": "ZynthNetwork",
        "method": "initializeWith:"
      }
    },
    "android": {
      "modules": [
        {
          "name": "ZynthNetwork",
          "path": "./android/ZynthNetwork"
        }
      ],
      "initializer": {
        "className": "Network",
        "method": "initialize",
        "package": "dev.zynth.network"
      }
    }
  }
}
