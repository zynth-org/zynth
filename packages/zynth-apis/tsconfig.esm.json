{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist/esm",
    "declaration": false,
    "emitDeclarationOnly": false,
    "types": [
      "zynth-jsx"
    ],
    "paths": {
      "solid-js/jsx-runtime": [
        "types/zynth-jsx/jsx-runtime.d.ts"
      ],
      "solid-js/jsx-dev-runtime": [
        "types/zynth-jsx/jsx-runtime.d.ts"
      ],
      "@zynthjs/apis": [
        "packages/zynth-apis/src/index.ts"
      ],
      "@zynthjs/apis/*": [
        "packages/zynth-apis/src/*"
      ],
      "@zynthjs/components": [
        "packages/zynth-components/src/index.ts"
      ],
      "@zynthjs/components/*": [
        "packages/zynth-components/src/*"
      ],
      "@zynthjs/core": [
        "../zynth-core/dist/types/index.d.ts"
      ],
      "@zynthjs/core/*": [
        "../zynth-core/dist/types/*"
      ],
      "@zynthjs/core/universal": [
        "packages/zynth-core/src/universal.ts"
      ],
      "@zynthjs/ui": [
        "packages/zynth-ui/src/index.ts"
      ],
      "@zynthjs/ui/*": [
        "packages/zynth-ui/src/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}
