{
  "name": "@zynthjs/apis",
  "version": "0.0.1-alpha.4",
  "description": "Core native APIs for Zynth, including platform detection, dimensions, and robust custom font management with Skia support.",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zynth-org/zynth",
    "directory": "packages/zynth-apis"
  },
  "homepage": "https://github.com/zynth-org/zynth#readme",
  "bugs": {
    "url": "https://github.com/zynth-org/zynth/issues"
  },
  "keywords": [
    "zynth",
    "native-apis",
    "solid-js",
    "jsi",
    "ios",
    "android"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "android/build.gradle",
    "android/src",
    "ios",
    "src",
    "package.json",
    "README.md",
    "ZynthAPIs.podspec"
  ],
  "devDependencies": {
    "@rsbuild/core": "^1.0.1",
    "typescript": "^5.6.2"
  },
  "peerDependencies": {
    "@zynthjs/core": ">=0.0.1-alpha.4",
    "solid-js": ">=1.8.0"
  },
  "scripts": {
    "build": "yarn build:js && yarn build:types",
    "build:js": "rm -rf dist/esm && tsc --project tsconfig.esm.json",
    "build:types": "tsc --project tsconfig.types.json"
  },
  "zynthNative": {
    "ios": {
      "pods": [
        {
          "name": "ZynthAPIs",
          "podspec": "./ZynthAPIs.podspec"
        }
      ],
      "initializer": {
        "className": "ZynthAPIs",
        "method": "initializeWith:"
      }
    },
    "android": {
      "modules": [
        {
          "name": "ZynthAPIs",
          "path": "./android"
        }
      ],
      "initializer": {
        "className": "ZynthAPIs",
        "method": "initialize",
        "package": "dev.zynth.apis"
      }
    }
  }
}
