{
  "name": "@zynth/apis",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist",
    "android",
    "ios",
    "src",
    "package.json",
    "ZynthAPIs.podspec"
  ],
  "devDependencies": {
    "@rsbuild/core": "^1.0.1",
    "@zynth/components": "*",
    "typescript": "^5.6.2"
  },
  "peerDependencies": {
    "@zynth/core": ">=0.0.1",
    "@zynth/components": ">=0.0.1",
    "solid-js": ">=1.8.0"
  },
  "scripts": {
    "build": "yarn build:js && yarn build:types",
    "build:js": "rm -rf dist/esm && tsc --project tsconfig.esm.json",
    "build:types": "tsc --project tsconfig.types.json"
  },
  "zynthNative": {
    "ios": {
      "pods": [
        {
          "name": "ZynthAPIs",
          "podspec": "./ZynthAPIs.podspec"
        }
      ],
      "initializer": {
        "className": "ZynthAPIs",
        "method": "initializeWith:"
      }
    },
    "android": {
      "modules": [
        {
          "name": "ZynthAPIs",
          "path": "./android"
        }
      ],
      "initializer": {
        "className": "ZynthAPIs",
        "method": "initialize",
        "package": "dev.zynth.apis"
      }
    }
  }
}
