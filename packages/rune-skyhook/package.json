{
  "name": "@rune/skyhook",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:generate": "tsc -p tsconfig.json && drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsc -p tsconfig.json && drizzle-kit migrate --config drizzle.config.ts",
    "db:studio": "tsc -p tsconfig.json && drizzle-kit studio --config drizzle.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.948.0",
    "@hono/node-server": "^1.6.2",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.5.6",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "drizzle-kit": "^0.31.8",
    "tsx": "^4.19.2",
    "typescript": "^5.6.2"
  }
}
