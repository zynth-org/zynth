# Skyhook (local dev)
#
# Copy to `packages/rune-skyhook/.env` and adjust as needed.

# --- Server ---
SKYHOOK_PORT=9964

# --- Database (required) ---
DATABASE_URL=postgres://postgres:141518@192.168.110.163:5432/skyhook
DATABASE_POOL_MAX=10

# --- Storage / MinIO (required; server boots storage on startup) ---
SKYHOOK_STORAGE_BUCKET=skyhook
SKYHOOK_STORAGE_ENDPOINT=http://127.0.0.1:9000
SKYHOOK_STORAGE_REGION=us-east-1
SKYHOOK_STORAGE_ACCESS_KEY=minioadmin
SKYHOOK_STORAGE_SECRET_KEY=minioadmin
SKYHOOK_STORAGE_FORCE_PATH_STYLE=true
# Optional public URL used to build snapshot URLs
# SKYHOOK_STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:9000/skyhook

# --- LLM preview (optional) ---
# Defaults to `mock` (no network calls).
SKYHOOK_LLM_PROVIDER=mock

# If SKYHOOK_LLM_PROVIDER=openai
# SKYHOOK_OPENAI_API_KEY=
# SKYHOOK_OPENAI_MODEL=gpt-4o-mini
# SKYHOOK_OPENAI_BASE_URL=

# If SKYHOOK_LLM_PROVIDER=gemini
# SKYHOOK_GEMINI_API_KEY=
# SKYHOOK_GEMINI_MODEL=gemini-1.5-flash
# SKYHOOK_GEMINI_BASE_URL=

# --- Agent runner (Phase 1.5) ---
SKYHOOK_AGENT_RUNNER=opencode
SKYHOOK_WORKSPACES_DIR=/tmp/skyhook-workspaces
SKYHOOK_OPENCODE_AGENT=rune-skyhook
# Set to true to enable agent execution.
# SKYHOOK_RUN_AGENT=true
# Retry count for build failures (default: 5)
# SKYHOOK_BUILD_RETRIES=5
# SKYHOOK_OPENCODE_MODEL=
OPENCODE_DISABLE_AUTOUPDATE=true
# Optional override for the bootstrap prompt file (default: `src/agent/prompts/bootstrap.md`)
# SKYHOOK_AGENT_BOOTSTRAP_PATH=

# --- Docker sandbox provisioning (Phase 2.4 starter) ---
# Set to `docker` to provision a Docker container (no agent execution inside yet).
# SKYHOOK_EXECUTION_MODE=local
SKYHOOK_EXECUTION_MODE=local

# Docker daemon socket (default shown)
# SKYHOOK_DOCKER_SOCKET=/var/run/docker.sock

# Sandbox container configuration
SKYHOOK_SANDBOX_IMAGE=alpine:3.20
SKYHOOK_SANDBOX_WORKDIR=/app
SKYHOOK_SANDBOX_WORKSPACE_MOUNT=/app/workspace

# Comma-separated env keys from the Skyhook server to pass into the sandbox container.
# Keep this empty for now (recommended) until we actually run the agent inside the container.
SKYHOOK_SANDBOX_ENV_ALLOWLIST=

# --- Build container ---
# Build container image (defaults to SKYHOOK_SANDBOX_IMAGE when unset)
# SKYHOOK_BUILD_IMAGE=rune-skyhook-sandbox:latest
# Maximum concurrent builds (default: 4)
# SKYHOOK_BUILD_CONCURRENCY=4
# Build container mounts
# SKYHOOK_BUILD_WORKDIR=/app
# SKYHOOK_BUILD_WORKSPACE_MOUNT=/app/workspace
# SKYHOOK_BUILD_ARTIFACTS_MOUNT=/opt/rune-artifacts
# Optional Yarn cache volume (host path + mount path)
# SKYHOOK_BUILD_YARN_CACHE_DIR=/tmp/skyhook-yarn-cache
# SKYHOOK_BUILD_YARN_CACHE_MOUNT=/opt/yarn-cache
