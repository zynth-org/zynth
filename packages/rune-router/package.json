{
  "name": "@rune/router",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "sideEffects": [
    "./src/platform/android/tabIconRenderer.tsx",
    "./src/platform/android/nativeRenderer.tsx",
    "./dist/esm/platform/android/tabIconRenderer.js",
    "./dist/esm/platform/android/nativeRenderer.js"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "ios",
    "RuneRouter.podspec"
  ],
  "peerDependencies": {
    "solid-js": ">=1.8.0",
    "@rune/safe-area": "0.0.1"
  },
  "dependencies": {
    "@rune/core": "0.0.1",
    "@rune/components": "0.0.1"
  },
  "devDependencies": {
    "@rsbuild/core": "^1.0.1",
    "solid-js": "^1.8.0",
    "typescript": "^5.6.2"
  },
  "scripts": {
    "build": "yarn build:js && yarn build:types",
    "build:js": "tsc --project tsconfig.esm.json",
    "build:types": "tsc --project tsconfig.types.json"
  },
  "runeNative": {
    "ios": {
      "pods": [
        {
          "name": "RuneRouter",
          "podspec": "./RuneRouter.podspec"
        }
      ]
    },
    "android": {
      "modules": [
        {
          "name": "RuneAndroidRouter",
          "path": "./android/RuneAndroidRouter"
        }
      ],
      "initializer": {
        "package": "com.rune.androidrouter",
        "className": "RuneAndroidRouterHost",
        "method": "bootstrap",
        "args": [
          "activity",
          "runtime",
          "rootView"
        ]
      }
    }
  }
}
