{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@rune/core": ["../rune-core/dist/types/index.d.ts"],
      "@rune/core/*": ["../rune-core/dist/types/*"]
    },
    "rootDir": "src",
    "outDir": "dist/esm",
    "declaration": false,
    "emitDeclarationOnly": false,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "solid-js"
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/index.web.ts"
  ]
}
