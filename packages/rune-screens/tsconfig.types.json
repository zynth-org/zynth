{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@rune/core": ["../rune-core/dist/types/index.d.ts"],
      "@rune/core/*": ["../rune-core/dist/types/*"]
    },
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/types",
    "jsx": "preserve",
    "jsxImportSource": "solid-js"
  },
  "include": ["src"],
  "exclude": ["src/index.web.ts"]
}
