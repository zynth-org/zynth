{
  "name": "@zynthjs/screens",
  "version": "0.0.1-alpha.0",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": [
    "./src/index.web.ts",
    "./web/**/*"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "android",
    "ios",
    "src",
    "web",
    "package.json",
    "README.md",
    "ZynthScreens.podspec"
  ],
  "exports": {
    ".": {
      "browser": "./src/index.web.ts",
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./web": "./web/index.ts"
  },
  "peerDependencies": {
    "solid-js": "2.0.0-rc.1",
    "@zynthjs/core": ">=0.0.1-alpha.4"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.24.7",
    "@babel/preset-typescript": "^7.24.7",
    "@rsbuild/core": "^1.0.1",
    "@rsbuild/plugin-babel": "^1.0.1",
    "babel-preset-solid": "^1.8.0",
    "solid-js": "2.0.0-rc.1",
    "typescript": "^5.6.2"
  },
  "scripts": {
    "build": "yarn build:js && yarn build:types",
    "build:js": "rm -rf dist/esm && esbuild src/*.ts src/*.tsx --outdir=dist/esm --format=esm --jsx=automatic --jsx-import-source=solid-js --loader:.ts=ts --loader:.tsx=tsx",
    "build:types": "tsc --project tsconfig.types.json"
  },
  "zynthNative": {
    "ios": {
      "pods": [
        {
          "name": "ZynthScreens",
          "podspec": "./ZynthScreens.podspec"
        }
      ]
    },
    "android": {
      "modules": [
        {
          "name": "ZynthScreens",
          "path": "./android/ZynthScreens"
        }
      ]
    }
  }
}
