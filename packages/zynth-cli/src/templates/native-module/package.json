{
  "name": "@zynth/{{MODULE_NAME}}",
  "version": "0.0.1",
  "description": "{{MODULE_DESCRIPTION}}",
  "type": "module",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "ios",
    "android",
    "Zynth{{MODULE_NAME_PASCAL}}.podspec"
  ],
  "scripts": {
    "build": "yarn build:js && yarn build:types",
    "build:js": "rm -rf dist/esm && tsc --project tsconfig.json",
    "build:types": "tsc --project tsconfig.types.json",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "zynth",
    "{{MODULE_NAME}}",
    "native-module"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@zynth/core": ">=0.0.1",
    "@zynth/components": ">=0.0.1",
    "solid-js": ">=1.8.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "zynthNative": {
    "ios": {
      "pods": [
        {
          "name": "Zynth{{MODULE_NAME_PASCAL}}",
          "podspec": "./Zynth{{MODULE_NAME_PASCAL}}.podspec"
        }
      ],
      "initializer": {
        "className": "{{MODULE_NAME_PASCAL}}Module",
        "method": "initializeWith:"
      }
    },
    "android": {
      "modules": [
        {
          "name": "Zynth{{MODULE_NAME_PASCAL}}",
          "path": "./android/Zynth{{MODULE_NAME_PASCAL}}"
        }
      ],
      "initializer": {
        "className": "{{MODULE_NAME_PASCAL}}",
        "method": "initialize",
        "package": "dev.zynth.{{MODULE_NAME}}"
      }
    }
  }
}
