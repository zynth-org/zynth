{
  "name": "@zynth/rsbuild-plugin",
  "version": "0.0.1",
  "description": "Zynth opinionated Rsbuild integration with Hermes-safe defaults and HMR token artifacts",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b && mkdir -p dist/loaders && cp src/loaders/*.cjs dist/loaders/",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "zynth",
    "rsbuild",
    "plugin",
    "hermes",
    "hmr"
  ],
  "license": "MIT",
  "dependencies": {
    "deepmerge": "^4.3.1",
    "solid-refresh": "^0.7.8"
  },
  "peerDependencies": {
    "@rsbuild/core": ">=1.5.0",
    "@rsbuild/plugin-babel": ">=1.0.0",
    "baseline-browser-mapping": "^2.9.14",
    "@rspack/core": ">=1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.6.3"
  }
}
