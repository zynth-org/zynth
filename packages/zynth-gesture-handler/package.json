{
  "name": "@zynth/gesture-handler",
  "version": "0.0.1",
  "description": "Gesture handling primitives for Zynth",
  "type": "module",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "ios",
    "android",
    "ZynthGestureHandler.podspec"
  ],
  "scripts": {
    "build": "yarn build:js && yarn build:types",
    "build:js": "rm -rf dist/esm && tsc --project tsconfig.esm.json",
    "build:types": "tsc --project tsconfig.types.json",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "zynth",
    "gesture",
    "gesture-handler",
    "solid-js",
    "native"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@zynth/core": ">=0.0.1",
    "solid-js": ">=1.8.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "zynthNative": {
    "ios": {
      "pods": [
        {
          "name": "ZynthGestureHandler",
          "podspec": "./ZynthGestureHandler.podspec"
        }
      ]
    },
    "android": {
      "modules": [
        {
          "name": "ZynthGestureHandler",
          "path": "./android/ZynthGestureHandler"
        }
      ]
    }
  }
}
