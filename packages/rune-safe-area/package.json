{
  "name": "@rune/safe-area",
  "version": "0.0.1",
  "description": "Safe area insets and frame utilities for Rune framework",
  "type": "module",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "ios",
    "android",
    "RuneSafeArea.podspec"
  ],
  "scripts": {
    "build": "yarn build:js && yarn build:types",
    "build:js": "tsc --project tsconfig.esm.json",
    "build:types": "tsc --project tsconfig.types.json",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "rune",
    "safe-area",
    "insets",
    "notch",
    "ios",
    "android"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@rune/core": ">=0.0.1",
    "@rune/components": ">=0.0.1",
    "solid-js": ">=1.8.0"
  },
  "devDependencies": {
    "@rsbuild/core": "^1.5.0",
    "@rune/rsbuild-plugin": "*",
    "typescript": "^5.6.3"
  },
  "runeNative": {
    "ios": {
      "pods": [
        {
          "name": "RuneSafeArea",
          "podspec": "./RuneSafeArea.podspec"
        }
      ],
      "initializer": {
        "className": "RuneSafeArea",
        "method": "initializeWith:"
      }
    },
    "android": {
      "modules": [
        {
          "name": "RuneSafeArea",
          "path": "./android/RuneSafeArea"
        }
      ],
      "initializer": {
        "className": "RuneSafeArea",
        "method": "initialize",
        "package": "dev.rune.safearea"
      }
    }
  }
}
