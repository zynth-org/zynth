{
  "name": "@rune/splash-screen",
  "version": "0.0.1",
  "description": "Native splash screen management for Rune framework",
  "type": "module",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "ios",
    "android",
    "RuneSplashScreen.podspec"
  ],
  "scripts": {
    "build": "yarn build:js && yarn build:types",
    "build:js": "rm -rf dist/esm && tsc --project tsconfig.esm.json",
    "build:types": "tsc --project tsconfig.types.json",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "rune",
    "splash-screen",
    "launch-screen",
    "ios",
    "android"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@rune/core": ">=0.0.1",
    "solid-js": ">=1.8.0"
  },
  "devDependencies": {
    "@rsbuild/core": "^1.5.0",
    "@rune/rsbuild-plugin": "*",
    "typescript": "^5.6.3"
  },
  "runeNative": {
    "ios": {
      "pods": [
        {
          "name": "RuneSplashScreen",
          "podspec": "./RuneSplashScreen.podspec"
        }
      ]
    },
    "android": {
      "modules": [
        {
          "name": "RuneSplashScreen",
          "path": "./android/RuneSplashScreen"
        }
      ],
      "initializer": {
        "className": "RuneSplashScreen",
        "method": "initialize",
        "package": "dev.rune.splashscreen",
        "args": ["activity", "runtime"]
      },
      "activityHooks": {
        "onCreate": ["RuneSplashScreen.attach(splashScreen)"],
        "onFirstFrame": ["RuneSplashScreen.markContentReady()"]
      }
    }
  }
}
