{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@zynth/bottom-sheet": ["../zynth-bottom-sheet/dist/types/index.d.ts"],
      "@zynth/bottom-sheet/*": ["../zynth-bottom-sheet/dist/types/*"]
    },
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "declaration": true,
    "emitDeclarationOnly": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist/types",
    "jsx": "preserve",
    "jsxImportSource": "solid-js"
  },
  "include": ["src"]
}
