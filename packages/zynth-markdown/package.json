{
  "name": "@zynthjs/markdown",
  "version": "0.0.1",
  "description": "Native markdown parser for Zynth apps",
  "type": "module",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "ios",
    "android",
    "native",
    "ZynthMarkdown.podspec",
    "src"
  ],
  "scripts": {
    "build": "yarn build:js && yarn build:types",
    "build:js": "rm -rf dist/esm && esbuild src/*.ts src/*.tsx --outdir=dist/esm --format=esm --jsx=automatic --jsx-import-source=solid-js --loader:.ts=ts --loader:.tsx=tsx",
    "build:types": "tsc --project tsconfig.types.json && mv dist/types/packages/zynth-markdown/src/* dist/types/ && rm -rf dist/types/packages",
    "clean": "rm -rf dist",
    "setup:cmark-gfm": "bash scripts/setup-cmark-gfm.sh"
  },
  "keywords": [
    "zynth",
    "markdown",
    "cmark-gfm",
    "ios",
    "android"
  ],
  "license": "MIT",
  "peerDependencies": {
    "solid-js": ">=1.8.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "zynthNative": {
    "ios": {
      "pods": [
        {
          "name": "ZynthMarkdown",
          "podspec": "./ZynthMarkdown.podspec"
        }
      ],
      "initializer": {
        "className": "ZynthMarkdown",
        "method": "initializeWith:"
      }
    },
    "android": {
      "modules": [
        {
          "name": "ZynthMarkdown",
          "path": "./android/ZynthMarkdown"
        }
      ],
      "initializer": {
        "className": "ZynthMarkdown",
        "method": "initialize",
        "package": "dev.zynth.markdown"
      }
    }
  }
}
