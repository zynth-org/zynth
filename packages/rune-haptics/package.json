{
  "name": "@rune/haptics",
  "version": "0.0.1",
  "description": "Haptics feedback for Rune framework",
  "type": "module",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "ios",
    "android",
    "RuneHaptics.podspec"
  ],
  "scripts": {
    "build": "yarn build:js && yarn build:types",
    "build:js": "rm -rf dist/esm && tsc --project tsconfig.esm.json",
    "build:types": "tsc --project tsconfig.types.json",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "rune",
    "haptics",
    "vibration",
    "ios",
    "android",
    "web"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@rune/core": ">=0.0.1",
    "solid-js": ">=1.9.9"
  },
  "devDependencies": {
    "@rsbuild/core": "^1.5.0",
    "@rune/rsbuild-plugin": "*",
    "typescript": "^5.6.3"
  },
  "runeNative": {
    "ios": {
      "pods": [
        {
          "name": "RuneHaptics",
          "podspec": "./RuneHaptics.podspec"
        }
      ],
      "initializer": {
        "className": "RuneHaptics",
        "method": "initializeWith:"
      }
    },
    "android": {
      "modules": [
        {
          "name": "RuneHaptics",
          "path": "./android/RuneHaptics"
        }
      ],
      "initializer": {
        "className": "RuneHaptics",
        "method": "initialize",
        "package": "dev.rune.haptics"
      }
    }
  }
}
