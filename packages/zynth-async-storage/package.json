{
  "name": "@zynthjs/async-storage",
  "version": "0.0.1",
  "description": "High-performance AsyncStorage for the Zynth framework",
  "type": "module",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "ios",
    "android",
    "ZynthAsyncStorage.podspec",
    "src"
  ],
  "scripts": {
    "build": "yarn build:js && yarn build:types",
    "build:js": "rm -rf dist/esm && tsc --project tsconfig.esm.json",
    "build:types": "tsc --project tsconfig.types.json",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "zynth",
    "async-storage",
    "storage",
    "jsi",
    "ios",
    "android"
  ],
  "license": "MIT",
  "peerDependencies": {
    "solid-js": ">=1.8.0"
  },
  "devDependencies": {
    "@rsbuild/core": "^1.5.0",
    "@zynthjs/rsbuild-plugin": "*",
    "typescript": "^5.6.3"
  },
  "zynthNative": {
    "ios": {
      "pods": [
        {
          "name": "ZynthAsyncStorage",
          "podspec": "./ZynthAsyncStorage.podspec"
        }
      ],
      "initializer": {
        "className": "ZynthAsyncStorage",
        "method": "initializeWith:"
      }
    },
    "android": {
      "modules": [
        {
          "name": "ZynthAsyncStorage",
          "path": "./android/ZynthAsyncStorage"
        }
      ],
      "initializer": {
        "className": "ZynthAsyncStorage",
        "method": "initialize",
        "package": "dev.zynth.asyncstorage"
      }
    }
  }
}
