{
  "name": "@rune/android-router",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "sideEffects": [
    "./src/nativeRenderer.ts",
    "./dist/esm/nativeRenderer.js"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "android"
  ],
  "peerDependencies": {
    "solid-js": ">=1.8.0",
    "@rune/safe-area": "0.0.1"
  },
  "dependencies": {
    "@rune/core": "0.0.1"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.24.7",
    "@rsbuild/core": "^1.0.1",
    "@rsbuild/plugin-babel": "^1.0.1",
    "babel-preset-solid": "^1.8.0",
    "solid-js": "^1.8.0",
    "typescript": "^5.6.2"
  },
  "scripts": {
    "build": "yarn build:js && yarn build:types",
    "build:js": "NODE_ENV=production rsbuild build --config rsbuild.config.ts",
    "build:types": "tsc --project tsconfig.types.json"
  },
  "runeNative": {
    "android": {
      "modules": [
        {
          "name": "RuneAndroidRouter",
          "path": "./android/RuneAndroidRouter"
        }
      ],
      "initializer": {
        "package": "com.rune.androidrouter",
        "className": "RuneAndroidRouterHost",
        "method": "bootstrap"
      }
    }
  }
}
