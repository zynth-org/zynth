{
  "name": "@zynth/animate",
  "version": "0.0.1-alpha.0",
  "description": "@deprecated — use @zynth/core/motion and @zynth/components instead. Backward-compatibility shim.",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "ios",
    "android",
    "ZynthAnimate.podspec",
    "src"
  ],
  "scripts": {
    "build": "yarn build:js && yarn build:types",
    "build:js": "rm -rf dist/esm && tsc --project tsconfig.esm.json",
    "build:types": "tsc --project tsconfig.types.json",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "zynth",
    "animate",
    "animation",
    "shared-value",
    "solid-js"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@zynth/core": ">=0.0.1-alpha.0",
    "@zynth/components": ">=0.0.1-alpha.0",
    "solid-js": ">=1.8.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
