{
  "name": "@zynth/animate",
  "version": "0.0.1-alpha.0",
  "description": "Animation primitives for Zynth",
  "type": "module",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "ios",
    "android",
    "ZynthAnimate.podspec",
    "src"
  ],
  "scripts": {
    "build": "yarn build:js && yarn build:types",
    "build:js": "rm -rf dist/esm && tsc --project tsconfig.esm.json",
    "build:types": "tsc --project tsconfig.types.json",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "zynth",
    "animate",
    "animation",
    "shared-value",
    "solid-js"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@zynth/core": ">=0.0.1-alpha.0",
    "@zynth/components": ">=0.0.1-alpha.0",
    "solid-js": ">=1.8.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "zynthNative": {
    "ios": {
      "pods": [
        {
          "name": "ZynthAnimate",
          "podspec": "./ZynthAnimate.podspec"
        }
      ],
      "initializer": {
        "className": "ZynthAnimate",
        "method": "initializeWith:"
      }
    },
    "android": {
      "modules": [
        {
          "name": "ZynthAnimate",
          "path": "./android/ZynthAnimate"
        }
      ],
      "initializer": {
        "className": "ZynthAnimate",
        "method": "initialize",
        "package": "dev.zynth.animate",
        "args": [
          "runtime"
        ]
      }
    }
  }
}
