{
  "name": "@zynth/icons",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "sideEffects": [
    "./src/index.web.ts",
    "./web/**/*"
  ],
  "license": "MIT",
  "files": [
    "assets",
    "dist",
    "android",
    "ios",
    "web",
    "src",
    "package.json",
    "README.md",
    "ZynthIcons.podspec"
  ],
  "peerDependencies": {
    "solid-js": ">=1.8.0",
    "@zynth/components": "^0.0.1",
    "@zynth/apis": "^0.0.1"
  },
  "devDependencies": {
    "@zynth/components": "^0.0.1",
    "@zynth/apis": "^0.0.1",
    "typescript": "^5.0.0",
    "solid-js": "^1.8.0",
    "solid-icons": "1.1.0",
    "svgtofont": "6.5.0"
  },
  "scripts": {
    "build": "yarn build:js && yarn build:types",
    "build:js": "rm -rf dist/esm && tsc --project tsconfig.esm.json",
    "build:types": "tsc --project tsconfig.types.json",
    "generate": "node --experimental-strip-types scripts/generate.ts"
  },
  "zynthNative": {
    "ios": {
      "pods": [
        {
          "name": "ZynthIcons",
          "podspec": "./ZynthIcons.podspec"
        }
      ]
    },
    "android": {
      "modules": [
        {
          "name": "ZynthIcons",
          "path": "./android"
        }
      ]
    }
  }
}
