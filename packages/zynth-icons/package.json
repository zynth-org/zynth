    "@zynthjs/components": "^0.0.1-alpha.0",
    "@zynthjs/apis": "^0.0.1-alpha.0",
    "typescript": "^5.0.0",
    "solid-js": "^1.8.0",
    "solid-icons": "1.1.0",
    "svgtofont": "6.5.0"
  },
  "scripts": {
    "build": "rm -rf dist && yarn build:js && yarn build:types && yarn generate",
    "build:js": "esbuild src/createIcon.tsx src/createSvgIcon.tsx --outdir=dist/esm --format=esm --jsx=automatic --jsx-import-source=solid-js --loader:.tsx=tsx",
    "build:types": "tsc --project tsconfig.types.json && mv dist/types/packages/zynth-icons/src/* dist/types/ && rm -rf dist/types/packages",
    "generate": "node --experimental-strip-types scripts/generate.ts"
  },
  "zynthNative": {
    "ios": {
      "pods": [
        {
          "name": "ZynthIcons",
          "podspec": "./ZynthIcons.podspec"
        }
      ]
    },
    "android": {
      "modules": [
        {
          "name": "ZynthIcons",
          "path": "./android"
        }
      ]
    }
  }
