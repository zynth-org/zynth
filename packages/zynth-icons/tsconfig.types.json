{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": "../../",
    "outDir": "dist/types",
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": "../../",
    "types": ["zynth-jsx"],
    "typeRoots": ["../../types", "../../node_modules/@types"],
    "paths": {
      "@zynthjs/components": ["packages/zynth-components/dist/types/zynth-components/src/index.d.ts"],
      "@zynthjs/core": ["packages/zynth-core/dist/types/index.d.ts"],
      "@zynthjs/core/*": ["packages/zynth-core/dist/types/*"],
      "@zynthjs/apis": ["packages/zynth-apis/dist/types/zynth-apis/src/index.d.ts"]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/index.web.ts"
  ]
}
