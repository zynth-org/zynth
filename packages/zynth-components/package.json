{
  "name": "@zynth/components",
  "version": "0.0.1",
  "description": "Native Zynth UI primitives and components for building SolidJS-powered iOS, Android, and partial web apps.",
  "type": "module",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "sideEffects": [
    "./src/index.web.ts",
    "./src/runtimeGlyphs.ts",
    "./dist/esm/runtimeGlyphs.js",
    "./web/**/*"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zynth-org/zynth",
    "directory": "packages/zynth-components"
  },
  "homepage": "https://github.com/zynth-org/zynth#readme",
  "bugs": {
    "url": "https://github.com/zynth-org/zynth/issues"
  },
  "keywords": [
    "zynth",
    "components",
    "solid-js",
    "native-ui",
    "ios",
    "android"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "android",
    "ios",
    "src",
    "web",
    "package.json",
    "README.md",
    "ZynthComponents.podspec"
  ],
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./web": "./web/index.ts"
  },
  "peerDependencies": {
    "solid-js": ">=1.8.0",
    "@zynth/core": "0.0.1",
    "@zynth/apis": "0.0.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.24.7",
    "@babel/preset-typescript": "^7.24.7",
    "@rsbuild/core": "^1.0.1",
    "@rsbuild/plugin-babel": "^1.0.1",
    "@zynth/apis": "0.0.1",
    "babel-preset-solid": "^1.8.0",
    "solid-js": "^1.8.0",
    "typescript": "^5.6.2"
  },
  "scripts": {
    "build": "yarn build:js && yarn build:types",
    "build:js": "rm -rf dist/esm && tsc --project tsconfig.esm.json",
    "build:types": "tsc --project tsconfig.types.json"
  },
  "zynthNative": {
    "ios": {
      "pods": [
        {
          "name": "ZynthComponents",
          "podspec": "./ZynthComponents.podspec"
        }
      ]
    },
    "android": {
      "modules": [
        {
          "name": "ZynthComponents",
          "path": "./android/ZynthComponents"
        }
      ],
      "gradleProjects": [
        {
          "name": "ZynthAPIs",
          "package": "@zynth/apis",
          "path": "./android"
        }
      ]
    }
  }
}
