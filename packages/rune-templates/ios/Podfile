platform :ios, '15.0'
use_frameworks! :linkage => :static

rune_ios_candidates = [
  File.expand_path('../node_modules/@rune/ios', __dir__),
  File.expand_path('../../node_modules/@rune/ios', __dir__),
  File.expand_path('../../../node_modules/@rune/ios', __dir__)
]

rune_ios_path = rune_ios_candidates.find { |candidate| File.exist?(candidate) }
raise "Unable to locate @rune/ios in node_modules (looked in #{rune_ios_candidates.join(', ')})" unless rune_ios_path

target '{{APP_NAME}}' do
  pod 'Yoga'
  pod 'RuneKit', :path => rune_ios_path
end

post_install do |installer|
  installer.pods_project.targets.each do |t|
    t.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
      config.build_settings['CLANG_CXX_LIBRARY'] = 'libc++'

      other_cxx = config.build_settings['OTHER_CPLUSPLUSFLAGS'] || '$(inherited)'
      other_c = config.build_settings['OTHER_CFLAGS'] || '$(inherited)'
      config.build_settings['OTHER_CPLUSPLUSFLAGS'] = "#{other_cxx} -std=c++17 -Wno-error"
      config.build_settings['OTHER_CFLAGS'] = "#{other_c} -Wno-error"
      config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
    end
  end

  yoga = installer.pods_project.targets.find { |t| t.name == 'Yoga' }
  if yoga
    yoga.build_configurations.each do |config|
      config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
      config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
      config.build_settings['WARNING_CFLAGS'] = ''
      config.build_settings['OTHER_CFLAGS'] = '-Wno-error'
      config.build_settings['OTHER_CPLUSPLUSFLAGS'] = '-std=c++17 -Wno-bitwise-instead-of-logical -Wno-error'
    end
  end

  installer.aggregate_targets.each do |aggregate_target|
    aggregate_target.user_targets.each do |t|
      t.build_phases.select do |p|
        p.respond_to?(:name) && ['Embed Pods Frameworks', 'Copy Pods Resources'].include?(p.name)
      end.each { |p| t.build_phases.delete(p) }
    end
  end
end
