{
  "name": "@rune/webserver",
  "version": "0.0.1",
  "description": "Embedded web server for Rune apps",
  "type": "module",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "ios",
    "android",
    "native",
    "RuneWebServer.podspec"
  ],
  "scripts": {
    "build": "yarn build:js && yarn build:types",
    "build:js": "rm -rf dist/esm && tsc --project tsconfig.esm.json",
    "build:types": "tsc --project tsconfig.types.json",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "rune",
    "webserver",
    "civetweb",
    "ios",
    "android"
  ],
  "license": "MIT",
  "peerDependencies": {
    "solid-js": ">=1.8.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "runeNative": {
    "ios": {
      "pods": [
        {
          "name": "RuneWebServer",
          "podspec": "./RuneWebServer.podspec"
        }
      ],
      "initializer": {
        "className": "RuneWebServer",
        "method": "initializeWith:"
      }
    },
    "android": {
      "modules": [
        {
          "name": "RuneWebServer",
          "path": "./android/RuneWebServer"
        }
      ],
      "initializer": {
        "className": "RuneWebServer",
        "method": "initialize",
        "package": "dev.rune.webserver"
      }
    }
  }
}
