{
  "name": "@zynthjs/ui",
  "version": "0.0.1-alpha.0",
  "description": "Theme system and UI primitives for Zynth",
  "type": "module",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "ios",
    "android",
    "ZynthUI.podspec",
    "src"
  ],
  "scripts": {
    "build": "yarn build:js && yarn build:types",
    "build:js": "rm -rf dist/esm && esbuild src/*.ts src/*.tsx src/**/*.ts src/**/*.tsx --outdir=dist/esm --format=esm --jsx=automatic --jsx-import-source=solid-js --loader:.ts=ts --loader:.tsx=tsx && cp -R src/themes dist/esm/themes",
    "build:types": "tsc --project tsconfig.types.json && mv dist/types/packages/zynth-ui/src/* dist/types/ && rm -rf dist/types/packages",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "zynth",
    "ui",
    "theme",
    "native-module"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@zynthjs/core": ">=0.0.1-alpha.0",
    "@zynthjs/components": ">=0.0.1-alpha.0",
    "solid-js": ">=1.8.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "zynthNative": {
    "ios": {
      "pods": [
        {
          "name": "ZynthUI",
          "podspec": "./ZynthUI.podspec"
        }
      ],
      "initializer": {
        "className": "ZynthUIBootstrap",
        "method": "initializeWith:"
      }
    },
    "android": {
      "modules": [
        {
          "name": "ZynthUI",
          "path": "./android/ZynthUI"
        }
      ],
      "initializer": {
        "className": "ZynthUIBootstrap",
        "method": "initialize",
        "package": "dev.zynth.ui"
      },
      "activityHooks": {
        "onConfigurationChanged": [
          "ZynthUIBootstrap.onConfigurationChanged(newConfig)"
        ]
      }
    }
  }
}
