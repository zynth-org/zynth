{
  "name": "@zynthjs/file-intents",
  "version": "0.0.1-alpha.0",
  "description": "System open/share/export intents for Zynth",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "ios",
    "android",
    "ZynthFileIntents.podspec",
    "src"
  ],
  "scripts": {
    "build": "yarn build:js && yarn build:types",
    "build:js": "rm -rf dist/esm && tsc --project tsconfig.esm.json",
    "build:types": "tsc --project tsconfig.types.json",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "zynth",
    "file-intents",
    "share",
    "open",
    "ios",
    "android"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "zynthNative": {
    "ios": {
      "pods": [
        {
          "name": "ZynthFileIntents",
          "podspec": "./ZynthFileIntents.podspec"
        }
      ],
      "initializer": {
        "className": "ZynthFileIntents",
        "method": "initializeWith:"
      }
    },
    "android": {
      "modules": [
        {
          "name": "ZynthFileIntents",
          "path": "./android/ZynthFileIntents"
        }
      ],
      "initializer": {
        "className": "ZynthFileIntents",
        "method": "initialize",
        "package": "dev.zynth.fileintents",
        "args": [
          "activity",
          "runtime"
        ]
      }
    }
  },
  "dependencies": {
    "@zynthjs/core": "0.0.1-alpha.0"
  }
}
