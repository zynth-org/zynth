{
  "name": "@zynth/error-overlay",
  "version": "0.0.1",
  "description": "Dev-only Redbox-style error and warning overlay for Zynth",
  "type": "module",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "package.json",
    "README.md"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@zynth/components": ">=0.0.1",
    "@zynth/core": ">=0.0.1",
    "solid-js": ">=1.9.9"
  },
  "devDependencies": {
    "typescript": "^5.6.2"
  },
  "scripts": {
    "build": "yarn build:js && yarn build:types",
    "build:js": "rm -rf dist/esm && tsc --project tsconfig.esm.json",
    "build:types": "tsc --project tsconfig.types.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "source-map-js": "^1.2.1"
  }
}
