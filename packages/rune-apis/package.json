{
  "name": "@rune/apis",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "sideEffects": false,
  "license": "MIT",
  "devDependencies": {
    "@rsbuild/core": "^1.0.1",
    "typescript": "^5.6.2"
  },
  "scripts": {
    "build": "yarn build:esm && yarn build:cjs && yarn build:types",
    "build:esm": "NODE_ENV=production rsbuild build --config rsbuild.esm.config.ts",
    "build:cjs": "NODE_ENV=production rsbuild build --config rsbuild.cjs.config.ts",
    "build:types": "tsc --project tsconfig.types.json"
  }
}
