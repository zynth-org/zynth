{
  "name": "@rune/apis",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist",
    "android",
    "ios",
    "src",
    "package.json",
    "RuneAPIs.podspec"
  ],
  "devDependencies": {
    "@rsbuild/core": "^1.0.1",
    "typescript": "^5.6.2"
  },
  "scripts": {
    "build": "yarn build:js && yarn build:types",
    "build:js": "rm -rf dist/esm && tsc --project tsconfig.esm.json",
    "build:types": "tsc --project tsconfig.types.json"
  },
  "runeNative": {
    "ios": {
      "pods": [
        {
          "name": "RuneAPIs",
          "podspec": "./RuneAPIs.podspec"
        }
      ],
      "initializer": {
        "className": "RuneAPIs",
        "method": "initializeWith:"
      }
    },
    "android": {
      "modules": [
        {
          "name": "RuneAPIs",
          "path": "./android"
        }
      ],
      "initializer": {
        "className": "RuneAPIs",
        "method": "initialize",
        "package": "dev.rune.apis"
      }
    }
  }
}
