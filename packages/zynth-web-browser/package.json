{
  "name": "@zynth/web-browser",
  "version": "0.0.1-alpha.0",
  "description": "System browser primitives for Zynth",
  "type": "module",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "ios",
    "android",
    "ZynthWebBrowser.podspec"
  ],
  "scripts": {
    "build": "yarn build:js && yarn build:types",
    "build:js": "rm -rf dist/esm && tsc --project tsconfig.esm.json",
    "build:types": "tsc --project tsconfig.types.json",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@zynth/core": "0.0.1-alpha.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "zynthNative": {
    "ios": {
      "pods": [
        {
          "name": "ZynthWebBrowser",
          "podspec": "./ZynthWebBrowser.podspec"
        }
      ],
      "initializer": {
        "className": "ZynthWebBrowser",
        "method": "initializeWith:"
      }
    },
    "android": {
      "modules": [
        {
          "name": "ZynthWebBrowser",
          "path": "./android/ZynthWebBrowser"
        }
      ],
      "initializer": {
        "className": "ZynthWebBrowser",
        "method": "initialize",
        "package": "dev.zynth.webbrowser"
      }
    }
  }
}
