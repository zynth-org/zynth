{
  "name": "@zynth/document-picker",
  "version": "0.0.1",
  "description": "Document picker for Zynth",
  "type": "module",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./web": "./web/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "ios",
    "android",
    "src",
    "web",
    "ZynthDocumentPicker.podspec"
  ],
  "scripts": {
    "build": "yarn build:js && yarn build:types",
    "build:js": "rm -rf dist/esm && tsc --project tsconfig.esm.json",
    "build:types": "tsc --project tsconfig.types.json",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "zynth",
    "document-picker",
    "files",
    "ios",
    "android"
  ],
  "license": "MIT",
  "peerDependencies": {},
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "zynthNative": {
    "ios": {
      "pods": [
        {
          "name": "ZynthDocumentPicker",
          "podspec": "./ZynthDocumentPicker.podspec"
        }
      ],
      "initializer": {
        "className": "ZynthDocumentPicker",
        "method": "initializeWith:"
      }
    },
    "android": {
      "modules": [
        {
          "name": "ZynthDocumentPicker",
          "path": "./android/ZynthDocumentPicker"
        }
      ],
      "initializer": {
        "className": "ZynthDocumentPicker",
        "method": "initialize",
        "package": "dev.zynth.documentpicker"
      }
    }
  }
}
