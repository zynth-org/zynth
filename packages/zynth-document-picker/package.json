{
  "name": "@zynthjs/document-picker",
  "version": "0.0.1",
  "description": "Document picker for Zynth",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "ios",
    "android",
    "ZynthDocumentPicker.podspec",
    "src"
  ],
  "scripts": {
    "build": "yarn build:js && yarn build:types",
    "build:js": "rm -rf dist/esm && tsc --project tsconfig.esm.json",
    "build:types": "tsc --project tsconfig.types.json",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "zynth",
    "document-picker",
    "files",
    "ios",
    "android"
  ],
  "license": "MIT",
  "peerDependencies": {},
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "zynthNative": {
    "ios": {
      "pods": [
        {
          "name": "ZynthDocumentPicker",
          "podspec": "./ZynthDocumentPicker.podspec"
        }
      ],
      "initializer": {
        "className": "ZynthDocumentPicker",
        "method": "initializeWith:"
      }
    },
    "android": {
      "modules": [
        {
          "name": "ZynthDocumentPicker",
          "path": "./android/ZynthDocumentPicker"
        }
      ],
      "initializer": {
        "className": "ZynthDocumentPicker",
        "method": "initialize",
        "package": "dev.zynth.documentpicker"
      }
    }
  }
}
