{
  "name": "@zynth/core",
  "version": "0.0.1",
  "description": "Zynth native runtime, SolidJS renderer, JSI host interface, and flex layout core.",
  "type": "module",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./universal": {
      "import": "./dist/esm/universal.js",
      "types": "./dist/types/universal.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "ios/ZynthKit",
    "ios/hermes-engine",
    "android/ZynthKit/src",
    "android/ZynthKit/CMakeLists.txt",
    "android/ZynthKit/build.gradle.kts",
    "android/ZynthKit/consumer-rules.pro",
    "ZynthKit.podspec",
    "README.md"
  ],
  "sideEffects": [
    "./src/polyfills/URLSearchParams.ts",
    "./src/polyfills/URL.ts",
    "./src/polyfills/TextEncoding.ts",
    "./src/polyfills/AbortController.ts",
    "./src/polyfills/ReadableStream.ts",
    "./src/polyfills/Blob.ts",
    "./src/polyfills/FormData.ts",
    "./src/polyfills/fetch/index.ts",
    "./src/index.ts",
    "./dist/esm/index.js"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zynth-org/zynth",
    "directory": "packages/zynth-core"
  },
  "homepage": "https://github.com/zynth-org/zynth#readme",
  "bugs": {
    "url": "https://github.com/zynth-org/zynth/issues"
  },
  "keywords": [
    "zynth",
    "solid-js",
    "native-runtime",
    "jsi",
    "yoga",
    "ios",
    "android"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "solid-js": ">=1.8.0"
  },
  "devDependencies": {
    "@rsbuild/core": "^1.0.1",
    "solid-js": "^1.8.0",
    "typescript": "^5.6.2"
  },
  "scripts": {
    "build": "yarn build:js && yarn build:types",
    "build:js": "rm -rf dist/esm && tsc --project tsconfig.esm.json",
    "build:types": "tsc --project tsconfig.types.json"
  }
}
