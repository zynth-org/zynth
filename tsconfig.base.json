{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@rune/core": ["packages/rune-core/src/index.ts"],
      "@rune/core/*": ["packages/rune-core/src/*"],
      "@rune/components": ["packages/rune-components/src/index.ts"],
      "@rune/components/*": ["packages/rune-components/src/*"],
      "@rune/apis": ["packages/rune-apis/src/index.ts"],
      "@rune/apis/*": ["packages/rune-apis/src/*"]
    }
  }
}
