{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "typeRoots": ["./types", "./node_modules/@types"],
    "types": ["zynth-jsx"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "solid-js/jsx-runtime": ["types/zynth-jsx/jsx-runtime.d.ts"],
      "solid-js/jsx-dev-runtime": ["types/zynth-jsx/jsx-runtime.d.ts"],
      "@zynthjs/apis": ["packages/zynth-apis/src/index.ts"],
      "@zynthjs/apis/*": ["packages/zynth-apis/src/*"],
      "@zynthjs/components": ["packages/zynth-components/src/index.ts"],
      "@zynthjs/components/*": ["packages/zynth-components/src/*"],
      "@zynthjs/core": ["packages/zynth-core/src/index.ts"],
      "@zynthjs/core/*": ["packages/zynth-core/src/*"],
      "@zynthjs/core/universal": ["packages/zynth-core/src/universal.ts"],
      "@zynthjs/ui": ["packages/zynth-ui/src/index.ts"],
      "@zynthjs/ui/*": ["packages/zynth-ui/src/*"]
    }
  }
}
