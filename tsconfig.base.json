      "@zynthjs/splash-screen": ["packages/zynth-splash-screen/src/index.ts"],
      "@zynthjs/splash-screen/*": ["packages/zynth-splash-screen/src/*"],
      "@zynthjs/ui": ["packages/zynth-ui/src/index.ts"],
      "@zynthjs/ui/*": ["packages/zynth-ui/src/*"],
      "@zynthjs/webserver": ["packages/zynth-webserver/src/index.ts"],
      "@zynthjs/webserver/*": ["packages/zynth-webserver/src/*"],
      "@zynthjs/webview": ["packages/zynth-webview/src/index.ts"],
      "@zynthjs/webview/*": ["packages/zynth-webview/src/*"],
