{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@rune/core": ["packages/rune-core/src/index.ts"],
      "@rune/core/*": ["packages/rune-core/src/*"]
    }
  }
}
