{
  "name": "@zynth/framework",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "yarn workspaces run build",
    "build:packages": "node --experimental-strip-types scripts/build-packages.ts",
    "clean": "git clean -xfd -e apps/*/ios/Pods -e apps/*/ios/*.xcworkspace",
    "bootstrap:ios": "yarn workspace @demo/sn-demo bootstrap:ios",
    "bootstrap:android": "yarn workspace @demo/sn-demo bootstrap:android",
    "ios:dev": "yarn workspace @demo/sn-demo ios:dev",
    "android:dev": "yarn workspace @demo/sn-demo android:dev",
    "bundle:apps": "zynth bundle apps",
    "bundle:packages": "zynth bundle packages",
    "bundle": "zynth bundle all",
    "reset:ios": "yarn workspace @demo/sn-demo reset:ios",
    "reset:android": "yarn workspace @demo/sn-demo reset:android",
    "generate": "node --experimental-strip-types scripts/generate.ts",
    "sync-aliases": "node scripts/sync-workspace-aliases.js",
    "new:package": "node --experimental-strip-types scripts/new-package.ts",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:pre": "changeset pre",
    "version:packages": "changeset version",
    "release:preflight": "node --experimental-strip-types scripts/release-preflight.ts",
    "release:packages": "changeset publish",
    "release:alpha": "changeset publish --tag alpha"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@types/node": "^25.0.3",
    "baseline-browser-mapping": "^2.9.14",
    "hermes-compiler": "250829098.0.6",
    "solid-refresh": "^0.7.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "zynth": "*"
  }
}
